{
  "$schema": "https://opencode.ai/config.json",
  // Project example: disabled to avoid duplicating the global router.
  // install.ps1/install.sh replace routing:false with global routing.json.
  "plugins": [{ "package": "./plugins/routing.ts", "options": { "routing": false } }],
  "websearch": { "provider": "random" },
  // ponytail: lean global template. No providers/keys here - providers stay user-local.
  // Only 2 MCPs enabled (jev local + context7 remote). Everything else: skill or CLI first.
  "model": "opencode-go/muse-spark-1.3-contributor",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "build",
  "tool_output": {
    "max_lines": 60,
    "max_bytes": 4096
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    }
  },
  "permission": {
    "shell": "ask"
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    }
  ],
  "agent": {
    "prompter": {
      "description": "Sharpens vague prompts into a Brief and routes: Jev/Laya (no LLM) vs cheap subagent vs primary. Always first on ambiguous requests. Routes uncertain/external questions to web-research.",
      "mode": "all",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "planner": {
      "description": "Plans only. Writes PLAN.md with disjoint parallel tasks. Never implements.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.3,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "worker": {
      "description": "Implements one disjoint task from PLAN.md. Verifies with the task check command. Searches web/GitHub/Reddit when unsure (see web-research skill).",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "explore": {
      "description": "Read-only codebase search. No edits, no heavy tools. Uses websearch for similar repos/patterns when local code is thin.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "tools": {
        "playwright*": false,
        "filesystem*": false,
        "context7*": false,
        "lsp*": false
      },
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "description": "Reviews diffs for correctness and regressions. Read-only.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "docs": {
      "description": "Writes summaries, changelogs, and docs. Small edits only.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "tests": {
      "description": "Writes and runs the smallest verification for a change. Reports pass/fail with the exact command.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "coder": {
      "description": "Writes the smallest working diff for one task. Verifies with the task check command.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "critic": {
      "description": "Attacks the coder diff. Read-only. Lists load-bearing bugs, never fixes.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "fixer": {
      "description": "Applies critic fixes only. Smallest patch, re-runs the task check.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.2,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  },
  "mcp": {
    "jev": {
      "type": "local",
      "command": [
        "C:\\Users\\witek\\Documents\\browseruse\\.venv\\Scripts\\python.exe",
        "C:/Users/witek/Documents/browseruse/jev_mcp.py"
      ],
      "enabled": true,
      "timeout": 600000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@latest",
        "mcp"
      ],
      "enabled": false,
      "timeout": 120000
    }
  }
}
